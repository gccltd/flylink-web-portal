# JSON map of recharge adapter keys to trusted action origins, e.g. {"alipay_v1":["https://example.com"]}. Optional; defaults to {}.
VITE_PORTAL_RECHARGE_TRUSTED_ACTION_ORIGINS_JSON=
# Set to "true" to enable the public ads click-binding handoff. Optional; defaults to "false".
VITE_PUBLIC_ADS_CLICK_BINDING_ENABLED=
